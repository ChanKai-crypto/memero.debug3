# Copie ce fichier en ".env" et remplis les valeurs avant de lancer le serveur.

# Port d'écoute du serveur (Render/Railway le fournissent automatiquement, sinon 4000 en local)
PORT=4000

# Secret utilisé pour signer les jetons de connexion (JWT). Mets une longue chaîne aléatoire.
# Génère-en une avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-moi-en-une-longue-chaine-aleatoire

# Identifiants du compte administrateur créé automatiquement au premier lancement
# (via "npm run seed:admin"). Change le mot de passe après la première connexion !
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-moi-vite
ADMIN_EMAIL=admin@example.com

# Origines autorisées à appeler l'API depuis un navigateur (séparées par des virgules).
# Mets l'adresse où sera hébergée ton app Memero (Netlify, Vercel, etc.), ou "*" en test.
CORS_ORIGIN=*

# --- Supabase (base de données) ---
# Crée un projet gratuit sur https://supabase.com, puis :
# - SUPABASE_URL : Project Settings → API → "Project URL"
# - SUPABASE_SERVICE_ROLE_KEY : Project Settings → API → "service_role" (secret !)
#   ⚠️ Ne mets JAMAIS cette clé dans le frontend / un dépôt public : elle donne
#   un accès total à la base, sans restriction.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=colle-ta-cle-service-role-ici
