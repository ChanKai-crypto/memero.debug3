# ============================================================
# Variables d'environnement du backend Memerro sur Render
# Render > ton service > Environment > « Add from .env » : colle tout
# ce fichier, remplace les valeurs <…>, puis « Save changes ».
# ============================================================

# --- Base de données (Supabase > Project Settings > API) ---
SUPABASE_URL=<https://xxxx.supabase.co>
SUPABASE_SERVICE_ROLE_KEY=<clé service_role (secrète)>

# --- Sécurité des connexions ---
# Garde la MÊME valeur qu'aujourd'hui sinon tout le monde est déconnecté.
JWT_SECRET=<ta valeur actuelle>

# --- Site (Netlify) ---
FRONTEND_URL=<https://memerro.com>
CORS_ORIGIN=*

# --- Stripe : ces lignes sont données toutes faites par
#     `node scripts/stripe-setup.js` (remplace ce bloc par sa sortie) ---
STRIPE_SECRET_KEY=<sk_test_… ou sk_live_…>
STRIPE_WEBHOOK_SECRET=<whsec_…>
STRIPE_PRICE_PLUS_MONTHLY=<price_…>   # Memerro Plus   11,99 €/mois
STRIPE_PRICE_PLUS_YEARLY=<price_…>    # Memerro Plus  111,99 €/an
STRIPE_PRICE_MAX_MONTHLY=<price_…>    # Memerro Max    12,99 €/mois
STRIPE_PRICE_MAX_YEARLY=<price_…>     # Memerro Max   123,99 €/an
STRIPE_PRICE_ULTRA_MONTHLY=<price_…>  # Memerro Ultra  18,99 €/mois
STRIPE_PRICE_ULTRA_YEARLY=<price_…>   # Memerro Ultra 180,99 €/an
STRIPE_PRICE_GEMS_MOYEN=<price_…> # 1 200 gemmes      5,99 €
STRIPE_PRICE_GEMS_GRAND=<price_…> # 3 000 gemmes     10,99 €
STRIPE_PRICE_GEMS_MEGA=<price_…>  # 6 500 gemmes     20,99 €

# --- E-mails (vérification, mot de passe oublié) : Gmail OU Resend ---
GMAIL_USER=<memerro65@gmail.com>
GMAIL_APP_PASSWORD=<mot de passe d'application Google>
# RESEND_API_KEY=<re_…>
# EMAIL_FROM=<Memerro <memerro65@gmail.com>>
